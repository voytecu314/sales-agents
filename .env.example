# LLM providers (tried in this order: Groq -> OpenRouter -> Requesty)
GROQ_API_KEY=gsk_xxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
REQUESTY_API_KEY=rqsty-xxxxxxxx

# Optional
# REQUESTY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# COMPANY_PROMPT_FILE=prompts/urban_web.txt   # system prompt of the Urban Web assistant at "/"
# PROVIDER_TIMEOUT_MS=60000
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
# PORT=3000

# MongoDB Atlas (agents are stored here). Atlas > Connect > Drivers > copy the connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sales-agents?retryWrites=true&w=majority
# Public address used in links and share previews. Without it the request's host is used.
# PUBLIC_BASE_URL=https://your-project.vercel.app
# Optional tuning
# AGENT_CACHE_TTL_MS=60000
# GENERATE_LIMIT_MAX=5
# GENERATE_LIMIT_WINDOW_MS=600000
# CREATE_LIMIT_MAX=10

# --- Phase 3 ---
# E-mail (nodemailer). Without SMTP_HOST, contact requests are only stored in the database.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Sales Agents <no-reply@example.com>"
# Secret for the e-mail confirmation links (any long random string). Required for confirming notification addresses.
EMAIL_VERIFY_SECRET=change-me-to-a-long-random-string
# Where "report this assistant" messages are sent (optional)
# ADMIN_EMAIL=you@example.com
# Salt for hashing IPs in rate limit counters (any random string)
# IP_SALT=
# Limits (defaults shown)
# DAILY_MESSAGE_CAP=200        # chat messages per agent and day
# LEAD_DAILY_CAP=50            # contact requests per agent and day
# AGENT_RATE_LIMIT_MAX=60      # chat messages per agent and minute (per instance)
# LEAD_RETENTION_DAYS=90
# Emergency stop for all LLM calls. Or set the document { key: "killSwitch", value: true } in the "settings" collection (no redeploy needed).
# KILL_SWITCH=false

# --- Owner keys and support ---
# How long an owner key works (days). After that only the admin can renew it: node scripts/admin.js rotate-key <slug>
# OWNER_KEY_DAYS=183
# Shown on the edit page ("lost your key? contact ...")
# SUPPORT_EMAIL=support@example.com

# --- Urban Web assistant (the page at "/") ---
# Contact requests from the page are stored in MongoDB (needs MONGODB_URI; without it the assistant does not offer the form)
# and e-mailed here via SMTP_* above. Falls back to ADMIN_EMAIL. Without SMTP_HOST nothing is sent, the requests are only stored.
# LEAD_NOTIFY_EMAIL=you@example.com

# --- Legal details shown in the privacy policy (/privacy). Fill these in before going live. ---
# LEGAL_NAME=Your company name
# LEGAL_ADDRESS=Street 1, 12345 City, Country
# LEGAL_EMAIL=privacy@example.com
# LEGAL_IMPRESSUM_URL=https://your-website.example/impressum   # your legal notice (Impressum): linked in the footer of every page
# LEGAL_HOSTING=Hosting and database providers, e.g. "Vercel Inc., MongoDB Atlas"   (optional)

# Optional OpenAI-compatible provider overrides (the defaults above are used when omitted)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# REQUESTY_BASE_URL=https://router.requesty.ai/v1
# REQUESTY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
