# LLM providers (tried in this order: Groq -> OpenRouter -> Requesty)
GROQ_API_KEY=gsk_xxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
REQUESTY_API_KEY=rqsty-xxxxxxxx

# Optional
# REQUESTY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# COMPANY_PROMPT_FILE=prompts/company.txt
# PROVIDER_TIMEOUT_MS=60000
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
# PORT=3000

# MongoDB Atlas (agents are stored here). Atlas > Connect > Drivers > copy the connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sales-agents?retryWrites=true&w=majority
# Public address used in links and share previews. Without it the request's host is used.
# PUBLIC_BASE_URL=https://your-project.vercel.app
# Optional tuning
# AGENT_CACHE_TTL_MS=60000
# GENERATE_LIMIT_MAX=5
# GENERATE_LIMIT_WINDOW_MS=600000
# CREATE_LIMIT_MAX=10
